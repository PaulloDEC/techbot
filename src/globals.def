/*
 * globals.def - every game global, with its offset in the original data
 * segment (DGROUP = 17E3h).  X-macros:  G(type, name, ds_offset)  and
 *                              GA(type, name, ds_offset, count) for arrays.
 *
 * The DS offset is kept so that the test harness can diff the C port's state
 * against the original running in an emulator, frame by frame.  Struct types are packed 16-bit fields that mirror the
 * original record layout exactly.
 *
 * Coordinate conventions used throughout the original:
 *   x  : 8-pixel columns ("half tiles"), world column of a map cell c is 2c+2
 *        (actors are therefore offset one tile to the right of the map).
 *   y  : 1/8-pixel units == map word offset of the row (row * 128).
 *        One tile row = 0x80, half a tile = 0x40.
 *   map cell (x, y) = map[y + x/2 - 1]   (see MAP_AT)
 *   The player is special: player_x is screen-relative (scroll_x + player_x
 *   is the world column) and player_y is in screen *pixels*.
 */

/* ---- program state / flags -------------------------------------------- */
G (int16_t,  cmd_asp,               0x0095)  /* argv[1]=="asp..." : cheats allowed     */
G (uint8_t,  sound_enabled,         0x0097)  /* PC speaker output on                   */
G (uint8_t,  demo_record,           0x0098)  /* 1=record USERDEMO, 2=record MY_DEMO    */
G (int16_t,  player_x,              0x0099)  /* screen column (8px), world = +scroll_x */
G (int16_t,  player_y,              0x009b)  /* screen pixel line of feet               */
G (int16_t,  scroll_x,              0x009d)  /* first visible column (8px units)       */
G (int16_t,  scroll_y,              0x009f)  /* first visible row * 128                */
GA(uint8_t,  key_bind,              0x02f4, 6)  /* scancodes: up,down,left,right,fire,jump */
G (uint8_t,  level_index,           0x02fa)  /* 0..20; odd = hallway                   */
G (uint16_t, timer_ticks,           0x02fb)  /* incremented by the 145 Hz timer ISR    */
G (int16_t,  cmd_chain_kbd,         0x039d)  /* argv[2] starts with 'g': chain INT 9   */
G (int16_t,  marquee_phase,        0x039f)
G (int16_t,  death_timer,           0x03a1)  /* !=0 while the death sequence plays     */
